# Local development only: choose your own password (14+ characters)
ADMIN_PASSWORD=ReplaceWithYourOwnStrongPassword
# Generate a random session secret, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Optional alternative: use ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=
ADMIN_COOKIE_SECURE=false
PORT=3001
